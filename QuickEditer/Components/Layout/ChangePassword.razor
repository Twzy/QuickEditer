@* 文件路径：Components/Pages/ChangePassword.razor *@
@page "/change-password"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using QuickEditer.Core
@using QuickEditer.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-page">
    <div class="login-box">
        <div class="login-title">修改密码</div>

        @if (Auth.MustChangePassword)
        {
            <div class="login-hint">首次登录或密码已被重置，请修改密码。</div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">@_error</div>
        }

        <label class="login-label">新密码</label>
        <input type="password" class="qe-input login-input" @bind="_pwd1" @bind:event="oninput" />

        <label class="login-label">确认新密码</label>
        <input type="password" class="qe-input login-input" @bind="_pwd2" @bind:event="oninput" />

        <button class="qe-btn qe-btn-primary login-submit" @onclick="SubmitAsync">
            保存
        </button>
    </div>
</div>

@code {
    private string _pwd1 = "";
    private string _pwd2 = "";
    private string _error = "";

    private async Task SubmitAsync()
    {
        _error = "";

        if (string.IsNullOrEmpty(_pwd1) || _pwd1.Length < 6)
        {
            _error = "密码至少 6 位";
            return;
        }

        if (_pwd1 != _pwd2)
        {
            _error = "两次输入不一致";
            return;
        }

        Auth.SetPassword(_pwd1, mustChange: false);
        Nav.NavigateTo("/");
        await Task.CompletedTask;
    }
}