@* 文件路径：Components/Share/ShortcutsDialog.razor *@
<div class="shortcuts-panel">
    <div class="shortcut-row"><kbd>Ctrl+S</kbd><span>保存当前文件</span></div>
    <div class="shortcut-row"><kbd>Ctrl+Shift+S</kbd><span>保存全部</span></div>
    <div class="shortcut-row"><kbd>Ctrl+B</kbd><span>编译</span></div>
    <div class="shortcut-row"><kbd>Ctrl+F</kbd><span>查找</span></div>
    <div class="shortcut-row"><kbd>Ctrl+H</kbd><span>替换</span></div>
    <div class="shortcut-row"><kbd>Ctrl+Shift+F</kbd><span>全局搜索</span></div>
    <div class="shortcut-row"><kbd>Ctrl+Z</kbd><span>撤销</span></div>
    <div class="shortcut-row"><kbd>Ctrl+Y</kbd><span>重做</span></div>
    <div class="shortcut-row"><kbd>Ctrl+C / V / X</kbd><span>复制 / 粘贴 / 剪切</span></div>
    <div class="shortcut-row"><kbd>Ctrl+A</kbd><span>全选</span></div>
</div>