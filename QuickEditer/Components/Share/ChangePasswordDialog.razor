@* 文件路径：Components/Share/ChangePasswordDialog.razor *@
@using QuickEditer.Services
@inject AuthService Auth

<div class="change-pwd-panel">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="change-pwd-error">@_error</div>
    }

    <label class="form-label">当前密码</label>
    <input type="password" class="qe-input mb-2" @bind="_oldPwd" @bind:event="oninput" />

    <label class="form-label">新密码</label>
    <input type="password" class="qe-input mb-2" @bind="_newPwd1" @bind:event="oninput" />

    <label class="form-label">确认新密码</label>
    <input type="password" class="qe-input" @bind="_newPwd2" @bind:event="oninput" />
</div>

@code {
    private string _oldPwd = "";
    private string _newPwd1 = "";
    private string _newPwd2 = "";
    private string _error = "";

    [Parameter] public EventCallback OnSaved { get; set; }

    public async Task SubmitAsync()
    {
        _error = "";

        if (string.IsNullOrEmpty(_oldPwd))
        {
            _error = "请输入当前密码";
            return;
        }

        var (ok, error) = Auth.Login(_oldPwd);
        if (!ok)
        {
            _error = error;
            return;
        }

        var (pok, pwdError) = AuthService.ValidatePasswordStrength(_newPwd1);
        if (!pok)
        {
            _error = pwdError;
            return;
        }

        if (_newPwd1 != _newPwd2)
        {
            _error = "两次输入的新密码不一致";
            return;
        }

        Auth.SetPassword(_newPwd1, mustChange: false);

        _oldPwd = "";
        _newPwd1 = "";
        _newPwd2 = "";

        if (OnSaved.HasDelegate)
            await OnSaved.InvokeAsync();
    }
}