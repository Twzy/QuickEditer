@* 文件路径：Components/Pages/Help.razor *@
@page "/help"
@rendermode InteractiveServer
@using QuickEditer.Components.Layout
@using QuickEditer.Core
@layout MainLayout

<div class="help-page">
    <div class="help-titlebar">
        <div class="help-titlebar-left">
            <i class="qe-ico qe-ico-book"></i>
            <span class="help-titlebar-title">帮助文档</span>
        </div>
        <div class="help-titlebar-right">
            <span class="help-titlebar-version">QuickEditer @Config.AppVersion</span>
        </div>
    </div>

    <div class="help-body">
        <div class="help-sidebar">
            <div class="help-nav">
                @foreach (var s in Sections)
                {
                    var key = s.Key;
                    <div class="help-nav-item @(_active == key ? "active" : "")" @onclick="() => _active = key">
                        <i class="qe-ico @s.Icon"></i> @s.Title
                    </div>
                }
            </div>
        </div>

        <div class="help-content">
            @if (_active == "start")
            {
                <h2>快速上手</h2>
                <ol class="help-list">
                    <li>点击顶部「新建项目」，输入项目名称、选择开发板与模板，创建项目。</li>
                    <li>在左侧资源管理器中双击文件，右侧编辑器打开代码。</li>
                    <li>点击工具栏「编译」按钮，编译输出显示在底部「输出」面板。</li>
                    <li>编译成功后，产物列表会出现固件文件，ESP 系列还会生成合并固件。</li>
                    <li>ESP 系列可点击产物后的烧录按钮，通过浏览器 Web Serial 直接烧录。</li>
                    <li>AVR 等其他芯片请下载固件，用本地工具烧录。</li>
                </ol>

                <h2>界面布局</h2>
                <ul class="help-list">
                    <li><b>标题栏</b>：显示应用名、版本、当前项目名，右侧显示「墨云软件」和退出登录按钮。</li>
                    <li><b>菜单栏</b>：文件、编辑、视图、构建、示例、帮助六个菜单。</li>
                    <li><b>工具栏</b>：常用操作按钮，从左到右依次为项目、编辑、开发板、编译、输出、管理、设置。</li>
                    <li><b>资源管理器</b>：左侧树形展示项目文件，可拖拽调整宽度。</li>
                    <li><b>编辑器</b>：中间代码编辑区，支持多页签。</li>
                    <li><b>底部面板</b>：输出日志、串口监视器，可切换、可关闭，支持拖动调整高度。</li>
                    <li><b>状态栏</b>：显示当前文件、行列、语言、编码、开发板。</li>
                </ul>

                <h2>项目结构</h2>
                <pre class="help-code">项目名/
    ├── 项目名.ino       主草图，与项目文件夹同名
    ├── 其他 .cpp / .h   可选代码文件
    ├── build/           编译产物
    └── logs/            编译日志</pre>

                <h2>首次登录</h2>
                <ul class="help-list">
                    <li>初始密码为 <code>quickadmin</code>，首次登录后强制修改密码。</li>
                    <li>新密码至少 8 位，需包含大写字母、小写字母、数字、特殊字符。</li>
                    <li>登录页可勾选「7 天内免密登录」，不勾选则关闭浏览器后失效。</li>
                    <li>连续 5 次密码错误锁定 30 分钟。</li>
                </ul>

                <h2>项目模板</h2>
                <ul class="help-list">
                    <li><b>空白项目</b>：最小 setup/loop 结构，含串口初始化。</li>
                    <li><b>Blink 闪烁 LED</b>：板载 LED 每秒闪烁。</li>
                    <li><b>串口打印</b>：每秒通过串口输出计数。</li>
                    <li><b>WiFi 连接（ESP）</b>：ESP32/ESP8266 连接 WiFi 并打印 IP。</li>
                </ul>

                <h2>最近项目</h2>
                <ul class="help-list">
                    <li>菜单「文件 → 最近项目」列出最近打开的 5 个项目，点击直接打开。</li>
                    <li>删除项目时同步从最近项目列表移除。</li>
                </ul>

                <h2>项目设置</h2>
                <ul class="help-list">
                    <li>标题栏项目名旁的齿轮按钮打开项目设置。</li>
                    <li>可修改项目描述、库依赖列表。</li>
                    <li>项目名称可修改，修改后目录和主草图文件同步重命名。</li>
                    <li>主草图文件名与项目同名，不可单独修改。</li>
                </ul>

                <h2>项目导出</h2>
                <ul class="help-list">
                    <li>菜单「文件 → 导出项目 ZIP」打包整个项目目录为 zip 下载。</li>
                    <li>包含源码、build 产物、logs 日志、project.xml 配置。</li>
                    <li>可用于备份或迁移到其他设备。</li>
                </ul>
            }
            else if (_active == "editor")
            {
                <h2>编辑器</h2>
                <ul class="help-list">
                    <li>支持 C/C++ 语法高亮、代码折叠、查找替换、多光标、列选择。</li>
                    <li>页签可拖动排序，中键关闭，右键页签可关闭其他/全部。</li>
                    <li>未保存的页签显示黄色圆点，关闭时提示保存、不保存、取消。</li>
                    <li>只读文件（示例代码、图片）页签带「只读」标识，不可编辑。</li>
                    <li>切换页签会恢复该文件的滚动位置。</li>
                    <li>底部状态栏实时显示光标行列、语言、编码。</li>
                </ul>

                <h2>文件类型</h2>
                <ul class="help-list">
                    <li><b>文本文件</b>：.ino、.cpp、.h、.txt、.md、.json、.xml、.yaml、.css、.js、.py、.cs 等，编辑器打开。</li>
                    <li><b>图片</b>：.png、.jpg、.jpeg、.gif、.bmp、.svg、.webp，图片查看器打开，只读。</li>
                    <li><b>固件</b>：.bin、.hex、.uf2、.eep，显示下载按钮，ESP 合并固件显示烧录按钮。</li>
                    <li><b>其他类型</b>：显示下载入口。</li>
                </ul>

                <h2>资源管理器</h2>
                <ul class="help-list">
                    <li>顶部搜索框按文件名过滤。</li>
                    <li>右键菜单：新建文件夹、新建文件、上传文件、重命名、删除、刷新。</li>
                    <li>文件可拖拽移动到其他文件夹。</li>
                    <li>主草图文件与项目同名，不可重命名。</li>
                    <li>文件图标按扩展名区分：代码、文本、数据、图片、固件。</li>
                    <li>顶部刷新按钮重新加载树，并同步未修改的已打开文件。</li>
                </ul>

                <h2>全局搜索</h2>
                <ul class="help-list">
                    <li>菜单「编辑 → 全局搜索」打开搜索弹窗。</li>
                    <li>遍历项目内所有文本文件，按关键字匹配，显示文件名、行号、内容片段。</li>
                    <li>点击结果打开对应文件。</li>
                    <li>最多返回 500 条结果，跳过 build、logs 目录。</li>
                </ul>

                <h2>编辑器设置</h2>
                <ul class="help-list">
                    <li><b>字体大小</b>：10–28，默认 14。</li>
                    <li><b>主题</b>：深色、浅色，影响整个应用 UI 和编辑器。</li>
                    <li><b>Minimap</b>：右侧代码缩略图，可关闭。</li>
                    <li><b>自动换行</b>：长行自动折行，默认关闭。</li>
                    <li><b>粘性滚动</b>：滚动时顶部显示当前作用域的方法名，默认关闭。</li>
                </ul>

                <h2>编辑器补全</h2>
                <ul class="help-list">
                    <li>输入 Arduino 常用函数前缀时自动提示补全。</li>
                    <li>支持 pinMode、digitalWrite、digitalRead、analogRead、analogWrite、delay、millis、map、constrain、Serial.* 等。</li>
                    <li>支持 setup、loop 代码片段，自动生成函数框架。</li>
                    <li>支持 HIGH、LOW、INPUT、OUTPUT、INPUT_PULLUP、LED_BUILTIN 常量补全。</li>
                    <li>手动触发补全：<kbd>Ctrl+Space</kbd>。</li>
                </ul>

                <h2>示例代码</h2>
                <ul class="help-list">
                    <li>菜单「示例」列出当前项目核心和所有已安装库的示例。</li>
                    <li>点击打开示例浏览弹窗，左侧列表示例，右侧显示文件树。</li>
                    <li>示例文件以只读页签打开，页签带「只读」标识。</li>
                    <li>示例图片可直接预览。</li>
                    <li>记住上次打开的示例，下次打开自动定位。</li>
                </ul>
            }
            else if (_active == "compile")
            {
                <h2>编译</h2>
                <ul class="help-list">
                    <li>编译前自动保存所有已修改文件。</li>
                    <li>项目设置中的库依赖会检查是否已安装，缺失时提示安装。</li>
                    <li>编译过程实时输出到「输出」面板，可随时点击「取消编译」中断。</li>
                    <li>编译日志保存在项目的 logs 目录，按时间命名，保留最近 20 个。</li>
                    <li>编译成功后产物列表显示固件文件，ESP32/ESP8266 会额外生成 .merged.bin 合并固件。</li>
                    <li>编译失败时日志显示完整错误，可滚动查看。</li>
                </ul>

                <h2>编译产物</h2>
                <ul class="help-list">
                    <li>产物显示在「输出」面板日志下方，带文件大小和下载按钮。</li>
                    <li>合并固件带「合并固件」标签，绿色高亮，排在最前，附带烧录按钮。</li>
                    <li>点击下载按钮保存文件到本地。</li>
                </ul>

                <h2>清理</h2>
                <ul class="help-list">
                    <li>「构建 → 清理构建」清空项目的 build 目录，下次编译重新生成。</li>
                    <li>「构建 → 清理日志」保留最近 20 个日志文件，删除更早的。</li>
                </ul>

                <h2>编译缓存</h2>
                <ul class="help-list">
                    <li>中间文件在项目的 build/tmp 目录。</li>
                    <li>核心缓存在 ArduinoCore/build-cache 目录，跨项目复用。</li>
                    <li>不会写入系统临时目录。</li>
                </ul>

                <h2>库依赖检查</h2>
                <ul class="help-list">
                    <li>编译前读取项目设置中的库依赖列表。</li>
                    <li>逐个检查是否已安装，缺失时弹窗列出缺失库并询问是否立即安装。</li>
                    <li>确认后自动调用 arduino-cli 安装，日志显示在输出面板。</li>
                    <li>取消则继续编译，可能因缺少头文件而失败。</li>
                </ul>

                <h2>编译日志文件</h2>
                <ul class="help-list">
                    <li>每次编译在项目 logs 目录生成一个日志文件，命名为 yyyyMMdd_HHmmss.log。</li>
                    <li>内容为本轮编译的完整输出，包括时间、级别、文本。</li>
                    <li>启动时自动清理，保留最近 20 个。</li>
                    <li>可在「构建 → 清理日志」手动清理。</li>
                </ul>

                <h2>FQBN 与开发板配置</h2>
                <ul class="help-list">
                    <li>FQBN 格式：包名:架构:板子ID，如 esp32:esp32:esp32c3。</li>
                    <li>开发板配置项拼接在 FQBN 后，如 esp32:esp32:esp32c3:CDCOnBoot=cdc。</li>
                    <li>多个配置项用逗号分隔。</li>
                    <li>配置项影响编译时的宏定义、分区表、Flash 参数。</li>
                </ul>
            }
            else if (_active == "flash")
            {
                <h2>在线烧录</h2>
                <ul class="help-list">
                    <li>仅支持 ESP32 / ESP8266 系列，通过浏览器 Web Serial 烧录。</li>
                    <li>需要 Chrome / Edge 等 Chromium 浏览器，且页面为 HTTPS 或 localhost。</li>
                    <li>入口：工具栏「在线烧录」按钮，或「构建 → 在线烧录」，或产物列表的烧录按钮。</li>
                    <li>弹窗列出 build 目录下所有固件，合并固件 .merged.bin 排第一位、默认选中、地址 0x0。</li>
                    <li>其他固件可选，地址自动推测（bootloader 0x1000、分区表 0x8000、boot_app0 0xe000、app 0x10000），可手动修改。</li>
                    <li>可选择波特率，默认 115200，支持全片擦除选项。</li>
                    <li>烧录日志实时显示在弹窗底部，失败时给出错误信息。</li>
                    <li>AVR 等其他芯片请下载固件后用本地工具烧录。</li>
                </ul>

                <h2>烧录注意事项</h2>
                <ul class="help-list">
                    <li>首次使用浏览器会弹出串口选择框，选择对应开发板的串口。</li>
                    <li>烧录前确认开发板已连接，串口未被其他工具占用。</li>
                    <li>合并固件包含 bootloader、分区表、应用，烧录一次即可完整写入。</li>
                    <li>单独烧录其他固件时，需同时选中多个文件并确认地址正确。</li>
                    <li>烧录完成后设备自动复位，可在串口监视器中查看输出。</li>
                </ul>

                <h2>合并固件</h2>
                <ul class="help-list">
                    <li>ESP32/ESP8266 编译成功后自动生成 .merged.bin。</li>
                    <li>合并 bootloader、分区表、boot_app0、应用为单个文件。</li>
                    <li>ESP32 地址：bootloader 0x1000、分区表 0x8000、boot_app0 0xe000、应用 0x10000。</li>
                    <li>ESP8266 地址：bootloader 0x0、分区表 0x1000、应用 0x2000。</li>
                    <li>烧录合并固件只需写入 0x0 一个地址，适合批量分发。</li>
                </ul>

                <h2>烧录流程</h2>
                <ol class="help-list">
                    <li>点击「在线烧录」打开弹窗。</li>
                    <li>选择波特率，默认 115200，可提高加快速度。</li>
                    <li>确认选中的固件和地址，合并固件默认选中，地址 0x0。</li>
                    <li>点击「开始烧录」，浏览器弹出串口选择框，选择开发板串口。</li>
                    <li>等待烧录完成，日志实时显示进度和结果。</li>
                    <li>成功后设备自动复位。</li>
                </ol>

                <h2>烧录失败排查</h2>
                <ul class="help-list">
                    <li><b>串口被占用</b>：关闭 Arduino IDE、串口调试工具等占用串口的程序。</li>
                    <li><b>连接超时</b>：检查 USB 线是否支持数据传输，部分线只供电。</li>
                    <li><b>芯片型号不匹配</b>：确认选择的固件与开发板芯片一致。</li>
                    <li><b>Flash 大小不匹配</b>：确认合并固件的 Flash 大小与开发板一致。</li>
                    <li><b>权限问题</b>：Linux 下需将用户加入 dialout 组才能访问串口。</li>
                </ul>
            }
            else if (_active == "serial")
            {
                <h2>串口监视器</h2>
                <ul class="help-list">
                    <li>选择波特率后点击「连接」，浏览器弹出串口选择框。</li>
                    <li>文本模式按行显示，数字模式绘制折线图，最多 200 个点，支持多列数据。</li>
                    <li>输入文本后点击「发送」或按回车发送，可勾选「换行」追加 \r\n。</li>
                    <li>关闭面板自动断开串口。</li>
                    <li>清空按钮清除文本历史和图表数据。</li>
                </ul>

                <h2>数字模式</h2>
                <ul class="help-list">
                    <li>每行按空格、逗号、分号拆成多个数字，绘制折线图。</li>
                    <li>多列数据用不同颜色区分，最多 6 种颜色循环。</li>
                    <li>Y 轴自动适应数据范围，左上角显示最大值，左下角显示最小值。</li>
                </ul>

                <h2>串口连接</h2>
                <ul class="help-list">
                    <li>支持波特率 9600–921600，常用 115200。</li>
                    <li>首次连接浏览器弹出串口选择框，列出所有可用串口。</li>
                    <li>连接后串口被浏览器独占，其他程序无法同时访问。</li>
                    <li>断开后释放串口，其他程序可重新连接。</li>
                    <li>关闭串口监视器面板自动断开。</li>
                </ul>

                <h2>文本模式</h2>
                <ul class="help-list">
                    <li>按 \n 分行显示，\r 自动去除。</li>
                    <li>最多保留 1000 行，超出后移除最早的行。</li>
                    <li>系统消息带 [系统] 前缀，错误消息带 [错误] 前缀。</li>
                    <li>发送的消息显示在日志中，带「发送：」前缀。</li>
                </ul>

                <h2>数据发送</h2>
                <ul class="help-list">
                    <li>输入框中输入内容，点击「发送」或按回车发送。</li>
                    <li>勾选「换行」时在末尾追加 \r\n，符合 Serial.println 习惯。</li>
                    <li>不勾选时原样发送，适合 Serial.print 或二进制数据。</li>
                    <li>发送内容通过 TextEncoder 编码为 UTF-8 字节流。</li>
                </ul>
            }
            else if (_active == "shortcuts")
            {
                <h2>编辑器快捷键</h2>
                <table class="help-table">
                    <thead>
                        <tr><th>快捷键</th><th>功能</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><kbd>Ctrl+S</kbd></td><td>保存当前文件</td></tr>
                        <tr><td><kbd>Ctrl+Z</kbd></td><td>撤销</td></tr>
                        <tr><td><kbd>Ctrl+Y</kbd></td><td>重做</td></tr>
                        <tr><td><kbd>Ctrl+X</kbd></td><td>剪切</td></tr>
                        <tr><td><kbd>Ctrl+C</kbd></td><td>复制</td></tr>
                        <tr><td><kbd>Ctrl+V</kbd></td><td>粘贴</td></tr>
                        <tr><td><kbd>Ctrl+A</kbd></td><td>全选</td></tr>
                        <tr><td><kbd>Ctrl+F</kbd></td><td>查找</td></tr>
                        <tr><td><kbd>Ctrl+H</kbd></td><td>替换</td></tr>
                        <tr><td><kbd>Ctrl+/</kbd></td><td>注释/取消注释</td></tr>
                        <tr><td><kbd>Alt+Click</kbd></td><td>多光标</td></tr>
                        <tr><td><kbd>Shift+Alt+拖动</kbd></td><td>列选择</td></tr>
                    </tbody>
                </table>

                <h2>界面快捷键</h2>
                <table class="help-table">
                    <thead>
                        <tr><th>操作</th><th>说明</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>双击文件</td><td>在编辑器中打开</td></tr>
                        <tr><td>中键点击页签</td><td>关闭页签</td></tr>
                        <tr><td>拖动页签</td><td>调整顺序</td></tr>
                        <tr><td>拖动分隔条</td><td>调整侧栏宽度、底部面板高度</td></tr>
                        <tr><td>右键文件树</td><td>打开右键菜单</td></tr>
                    </tbody>
                </table>

                <h2>浏览器快捷键</h2>
                <table class="help-table">
                    <thead>
                        <tr><th>快捷键</th><th>功能</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><kbd>F5</kbd></td><td>刷新页面，重新加载应用</td></tr>
                        <tr><td><kbd>Ctrl+F5</kbd></td><td>强制刷新，清除缓存</td></tr>
                        <tr><td><kbd>F12</kbd></td><td>打开开发者工具，查看控制台和网络</td></tr>
                        <tr><td><kbd>Ctrl+Shift+R</kbd></td><td>强制刷新并忽略缓存</td></tr>
                    </tbody>
                </table>
            }
            else if (_active == "board")
            {
                <h2>开发板管理</h2>
                <ul class="help-list">
                    <li>菜单「开发板管理」或工具栏按钮打开。</li>
                    <li>「更新索引并刷新」从官方和附加索引 URL 下载最新索引。</li>
                    <li>「已安装」标签显示已安装核心，可更新、切换版本、卸载。</li>
                    <li>「可安装」标签显示所有可用核心，选择版本后安装。</li>
                    <li>安装/卸载过程显示实时日志，完成后自动刷新列表。</li>
                    <li>安装失败时日志给出下载地址，可手动下载放入 staging 目录重试。</li>
                </ul>

                <h2>附加索引</h2>
                <ul class="help-list">
                    <li>开发板管理弹窗左下角「附加索引 URL」按钮打开配置。</li>
                    <li>每行一个 URL，或英文逗号分隔，保存后写入 arduino-cli.yaml。</li>
                    <li>保存后需在开发板管理中重新点「更新索引并刷新」生效。</li>
                    <li>常用附加索引：ESP32、ESP8266、Seeed、Raspberry Pi Pico 等。</li>
                </ul>

                <h2>开发板配置</h2>
                <ul class="help-list">
                    <li>工具栏「开发板配置」按钮打开，根据当前开发板列出可配置项。</li>
                    <li>如 CPU 频率、Flash 大小、分区表、上传速度等。</li>
                    <li>修改后编译时拼接到 FQBN，影响编译结果。</li>
                    <li>部分配置项仅影响本地工具烧录，不适用于浏览器在线烧录。</li>
                </ul>

                <h2>核心安装过程</h2>
                <ul class="help-list">
                    <li>从索引中获取核心包和工具链的下载地址。</li>
                    <li>下载到 ArduinoCore/staging 目录。</li>
                    <li>解压到 ArduinoCore/data/packages 目录。</li>
                    <li>安装工具链到 ArduinoCore/data/packages/{包名}/tools 目录。</li>
                    <li>过程日志实时显示在遮罩窗口中。</li>
                </ul>

                <h2>核心版本切换</h2>
                <ul class="help-list">
                    <li>已安装核心卡片显示可用版本下拉。</li>
                    <li>选择目标版本后点击「切换」，会重新安装该核心。</li>
                    <li>切换版本会保留项目文件，但编译结果可能不同。</li>
                    <li>推荐使用稳定版本，避免使用预览版或测试版。</li>
                </ul>

                <h2>核心缓存</h2>
                <ul class="help-list">
                    <li>下载的核心包保留在 staging 目录，卸载后不会自动删除。</li>
                    <li>重新安装相同版本时直接使用缓存，无需重新下载。</li>
                    <li>手动清理 staging 目录可释放磁盘空间。</li>
                </ul>
            }
            else if (_active == "library")
            {
                <h2>库管理</h2>
                <ul class="help-list">
                    <li>菜单「库管理」或工具栏按钮打开。</li>
                    <li>「同步索引」下载最新库索引并刷新列表。</li>
                    <li>「已安装」标签显示已安装库，可检查更新、卸载。</li>
                    <li>「可安装」标签显示所有可用库，按名称搜索，选择版本后安装。</li>
                    <li>安装/卸载过程显示实时日志，完成后自动刷新列表。</li>
                </ul>

                <h2>库依赖</h2>
                <ul class="help-list">
                    <li>项目设置中可以填写库依赖列表，每行一个库名。</li>
                    <li>编译时检查这些库是否已安装，缺失时提示安装。</li>
                    <li>库依赖仅记录在项目配置中，不自动安装。</li>
                </ul>

                <h2>库搜索</h2>
                <ul class="help-list">
                    <li>顶部搜索框按库名称过滤，输入即时生效。</li>
                    <li>仅匹配库名，不匹配作者、描述、分类。</li>
                    <li>已安装和可安装两个标签页分别过滤。</li>
                </ul>

                <h2>库安装</h2>
                <ul class="help-list">
                    <li>从本地 library_index.json 读取所有可安装库。</li>
                    <li>选择版本后点击「安装」，下载到 ArduinoCore/user/libraries 目录。</li>
                    <li>安装日志实时显示在遮罩窗口中。</li>
                    <li>安装完成后自动切换到「已安装」标签并刷新列表。</li>
                </ul>

                <h2>库卸载</h2>
                <ul class="help-list">
                    <li>已安装库卡片点击「卸载」，二次确认后执行。</li>
                    <li>卸载后库文件从 user/libraries 目录删除。</li>
                    <li>项目中引用该库的代码将无法编译，但源文件不会被删除。</li>
                    <li>可重新安装恢复。</li>
                </ul>

                <h2>检查更新</h2>
                <ul class="help-list">
                    <li>已安装库卡片点击「检查更新」，查询索引中该库的最新版本。</li>
                    <li>有新版本时弹窗提示当前版本和最新版本。</li>
                    <li>确认后可通过「卸载」再「安装」新版本，或直接在可安装列表选择新版本安装。</li>
                </ul>
            }
            else if (_active == "faq")
            {
                <h2>常见问题</h2>

                <h3>编译失败，提示未找到 arduino-cli</h3>
                <p>检查 Data/ArduinoCore 目录下是否有对应平台的 arduino-cli。首次启动会从程序根目录 Arduinolib 复制对应平台的可执行文件。</p>

                <h3>编译失败，提示 python3 找不到</h3>
                <p>ESP32/ESP8266 核心编译需要 Python 3。Linux 服务器安装 python3，Windows 确保 PATH 中有 python。推荐 Python 3.10 或更高版本。</p>

                <h3>编译失败，提示 HOME 未定义</h3>
                <p>Linux 下以 systemd 或其他无登录环境运行时，HOME 环境变量可能缺失。程序会自动设置 HOME 指向 ArduinoCore 目录，无需手动配置。</p>

                <h3>在线烧录时浏览器没有弹出串口选择</h3>
                <p>确认浏览器为 Chrome/Edge，页面为 HTTPS 或 localhost，且已允许串口权限。Firefox、Safari 不支持 Web Serial。</p>

                <h3>烧录合并固件后设备不启动</h3>
                <p>合并固件地址固定 0x0，若设备之前烧过自定义分区表，可能需要全片擦除后再烧。勾选烧录弹窗的「全片擦除」选项。</p>

                <h3>登录锁定</h3>
                <p>密码连续错误 5 次锁定 30 分钟，等待后重试。忘记密码需删除 Data/auth.xml 恢复初始密码 quickadmin。</p>

                <h3>修改端口后无法访问</h3>
                <p>端口修改需重启服务生效。若端口被占用，服务会回退到配置文件中上一个可用端口。</p>

                <h3>页面连接断开</h3>
                <p>Blazor Server 依赖 WebSocket 长连接。网络波动或服务重启会导致连接断开，页面会显示重连提示，自动重试 5 次后给出刷新按钮。</p>

                <h3>日志面板不显示内容</h3>
                <p>检查底部面板是否被关闭。工具栏「输出」按钮或菜单「视图 → 切换输出面板」可重新打开。面板状态会被记住。</p>

                <h3>下载的开发板或库存储在哪里</h3>
                <p>开发板核心在 Data/ArduinoCore/data/packages 目录，库在 Data/ArduinoCore/user/libraries 目录。所有数据都在 Data 目录下，方便备份和迁移。</p>

                <h3>页面加载缓慢</h3>
                <p>首次加载需要初始化 Monaco 编辑器和 arduino-cli 环境，可能需要几秒。后续加载会从缓存读取核心和库列表，速度较快。</p>

                <h3>切换主题后编辑器没变色</h3>
                <p>编辑器主题由应用主题控制，修改后立即生效。如果没变化，刷新页面或重新打开文件。</p>

                <h3>文件树中看不到 build 或 logs</h3>
                <p>build 和 logs 目录默认显示。如果被隐藏，点击资源管理器顶部刷新按钮重新加载。</p>

                <h3>无法删除项目</h3>
                <p>检查项目目录下是否有文件被其他程序占用。关闭编辑器、编译进程、资源管理器后重试。</p>

                <h3>上传文件失败</h3>
                <p>检查文件大小是否超过服务器限制，文件名是否包含特殊字符。上传时自动重命名重名文件，不会覆盖原文件。</p>

                <h3>打开大文件卡顿</h3>
                <p>Monaco 编辑器对超大文件性能有限。建议拆分代码文件，或将大文件放在 build 目录外单独管理。</p>

                <h3>全局搜索没有结果</h3>
                <p>全局搜索只匹配文本文件，跳过 build 和 logs 目录。确认关键字拼写正确，或尝试更短的关键字。</p>

                <h3>编译取消后进程残留</h3>
                <p>取消编译时程序会强制终止 arduino-cli 进程。如果仍有残留，手动结束 arduino-cli 进程或在系统中重启服务。</p>

                <h3>如何备份所有项目</h3>
                <p>直接复制 Data/Projects 目录到备份位置。每个项目包含完整源码、配置和编译产物，可单独导出 ZIP。</p>

                <h3>如何迁移到新服务器</h3>
                <p>复制整个 Data 目录到新服务器对应位置。包含项目、配置、认证信息、开发板和库。程序文件单独复制，Arduinolib 目录也要一并迁移。</p>

                <h3>能否多用户同时使用</h3>
                <p>当前为单用户设计，所有用户共享同一密码、同一项目列表、同一配置。多用户同时操作可能导致状态冲突，建议单人使用或部署多个实例。</p>

                <h3>如何修改监听端口</h3>
                <p>设置中修改端口后保存，重启服务生效。配置文件 Data/setting.xml 中的 HttpPort 字段也会同步更新。</p>

                <h3>如何启用 HTTPS</h3>
                <p>将证书文件 ssl.pem 和 ssl.key 放入 Data/certs 目录，重启服务自动启用 HTTPS。证书格式为 PEM，私钥不能加密。</p>
            }
        </div>
    </div>
</div>

